{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run KeyPrint",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder:keyprint}"],
      "outFiles": ["${workspaceFolder:keyprint}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Run KeyPrint (this folder)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}
